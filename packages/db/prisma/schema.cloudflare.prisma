generator client {
  provider = "prisma-client"
  output = "./generated/cloudflare"
  runtime = "cloudflare"
}
datasource db { provider = "sqlite" }

enum Role { SUPER_ADMIN ADMIN MANAGER SUPERVISOR EMPLOYEE CLIENT }
enum UserStatus { ACTIVE SUSPENDED PENDING }
enum ProjectStatus { PLANNED ACTIVE ON_HOLD COMPLETED CANCELLED }
enum TaskStatus { TODO IN_PROGRESS REVIEW DONE CANCELLED }
enum Priority { LOW MEDIUM HIGH URGENT }
enum TicketStatus { OPEN IN_PROGRESS WAITING_FOR_CLIENT RESOLVED CLOSED }
enum FieldType { TEXT TEXTAREA NUMBER EMAIL PHONE URL DATE SELECT MULTI_SELECT BOOLEAN IMAGE FILE }
enum NotificationChannel { IN_APP EMAIL PUSH WHATSAPP }
enum MessageType { TEXT IMAGE FILE PDF AUDIO }
enum LeadStatus { NEW CONTACTED QUALIFIED PROPOSAL WON LOST }
enum DealStatus { OPEN WON LOST }
enum AppRequestStatus { NEW ANALYSIS DESIGN DEVELOPMENT TESTING CLIENT_REVIEW REVISIONS READY_FOR_DELIVERY DELIVERED }
enum InvoiceStatus { DRAFT ISSUED PARTIALLY_PAID PAID OVERDUE CANCELLED }

model User {
  id String @id @default(cuid())
  email String? @unique
  passwordHash String
  name String
  phone String? @unique
  role Role @default(EMPLOYEE)
  status UserStatus @default(ACTIVE)
  avatarUrl String?
  isMasterSuperAdmin Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client Client?
  assignedProjects Project[] @relation("ProjectAssignee")
  supervisedProjects Project[] @relation("ProjectSupervisor")
  tasks Task[] @relation("TaskAssignee")
  supervisedEmployees Employee[] @relation("EmployeeSupervisor")
  auditLogs AuditLog[]
  rolePermissions RolePermission[] @relation("UserRolePermissions")
  sentMessages Message[] @relation("MessageSender")
  notifications Notification[]
  employee Employee?
  conversations ConversationMember[]
  leads Lead[] @relation("LeadOwner")
  deals Deal[] @relation("DealOwner")
  assignedAppRequests AppRequest[] @relation("AppRequestAssignee")
  comments ProjectComment[]
  createdFiles FileAsset[] @relation("FileUploader")
  createdInvoices Invoice[] @relation("InvoiceCreator")
}

model Permission {
  id String @id @default(cuid())
  key String @unique
  name String
  description String?
  rolePermissions RolePermission[]
  createdAt DateTime @default(now())
}
model RolePermission {
  id String @id @default(cuid())
  role Role
  permissionId String
  permission Permission @relation(fields:[permissionId],references:[id],onDelete:Cascade)
  userId String?
  user User? @relation("UserRolePermissions",fields:[userId],references:[id],onDelete:Cascade)
  enabled Boolean @default(true)
  @@unique([role,permissionId,userId])
}

model Client {
  id String @id @default(cuid())
  userId String @unique
  companyName String?
  whatsapp String?
  country String?
  city String?
  address String?
  website String?
  notes String?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  projects Project[]
  tickets Ticket[]
  files FileAsset[]
  leads Lead[]
  deals Deal[]
  appRequests AppRequest[]
  invoices Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id String @id @default(cuid())
  userId String @unique
  employeeNumber String @unique
  jobTitle String?
  department String?
  supervisorId String?
  hireDate DateTime?
  status String @default("ACTIVE")
  skills Json?
  evaluation Json?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  supervisor User? @relation("EmployeeSupervisor",fields:[supervisorId],references:[id],onDelete:SetNull)
  projects Project[] @relation("EmployeeProjects")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(cuid())
  projectNumber String @unique @default(cuid())
  name String
  description String?
  status ProjectStatus @default(PLANNED)
  priority Priority @default(MEDIUM)
  startDate DateTime?
  dueDate DateTime?
  progress Int @default(0)
  clientId String?
  assigneeId String?
  supervisorId String?
  serviceId String?
  client Client? @relation(fields:[clientId],references:[id],onDelete:SetNull)
  assignee User? @relation("ProjectAssignee",fields:[assigneeId],references:[id],onDelete:SetNull)
  supervisor User? @relation("ProjectSupervisor",fields:[supervisorId],references:[id],onDelete:SetNull)
  service Service? @relation(fields:[serviceId],references:[id],onDelete:SetNull)
  employees Employee[] @relation("EmployeeProjects")
  tasks Task[]
  files FileAsset[]
  comments ProjectComment[]
  appRequests AppRequest[]
  invoices Invoice[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model ProjectComment {
  id String @id @default(cuid())
  projectId String
  userId String
  body String
  createdAt DateTime @default(now())
  project Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}

model Task {
  id String @id @default(cuid())
  title String
  description String?
  status TaskStatus @default(TODO)
  priority Priority @default(MEDIUM)
  dueDate DateTime?
  progress Int @default(0)
  projectId String?
  assigneeId String?
  project Project? @relation(fields:[projectId],references:[id],onDelete:Cascade)
  assignee User? @relation("TaskAssignee",fields:[assigneeId],references:[id],onDelete:SetNull)
  files FileAsset[]
  comments TaskComment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model TaskComment {
  id String @id @default(cuid())
  taskId String
  userId String
  body String
  createdAt DateTime @default(now())
  task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}

model Service {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  imageUrl String?
  duration String?
  price Float?
  active Boolean @default(true)
  sortOrder Int @default(0)
  metadata Json?
  projects Project[]
  appRequests AppRequest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id String @id @default(cuid())
  ticketNumber String @unique @default(cuid())
  subject String
  message String
  status TicketStatus @default(OPEN)
  priority Priority @default(MEDIUM)
  clientId String?
  client Client? @relation(fields:[clientId],references:[id],onDelete:SetNull)
  files FileAsset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id String @id @default(cuid())
  key String @unique
  value String
  type String @default("text")
  updatedAt DateTime @updatedAt
}
model Page {
  id String @id @default(cuid())
  slug String @unique
  title String
  content Json
  published Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CustomField {
  id String @id @default(cuid())
  entity String
  key String
  label String
  type FieldType @default(TEXT)
  required Boolean @default(false)
  options Json?
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([entity,key])
}
model CustomFieldValue {
  id String @id @default(cuid())
  fieldId String
  entityId String
  value Json
  field CustomField @relation(fields:[fieldId],references:[id],onDelete:Cascade)
  @@unique([fieldId,entityId])
}

model FileAsset {
  id String @id @default(cuid())
  name String
  storageKey String
  url String?
  mimeType String?
  size Int?
  data Bytes?
  folder String?
  clientId String?
  projectId String?
  taskId String?
  ticketId String?
  uploadedById String?
  client Client? @relation(fields:[clientId],references:[id],onDelete:SetNull)
  project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull)
  task Task? @relation(fields:[taskId],references:[id],onDelete:SetNull)
  ticket Ticket? @relation(fields:[ticketId],references:[id],onDelete:SetNull)
  uploadedBy User? @relation("FileUploader",fields:[uploadedById],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
}

model Conversation {
  id String @id @default(cuid())
  title String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members ConversationMember[]
  messages Message[]
}
model ConversationMember {
  id String @id @default(cuid())
  conversationId String
  userId String
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([conversationId,userId])
}
model Message {
  id String @id @default(cuid())
  conversationId String
  senderId String
  body String?
  type MessageType @default(TEXT)
  fileId String?
  readAt DateTime?
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  sender User @relation("MessageSender",fields:[senderId],references:[id],onDelete:Cascade)
}

model Notification {
  id String @id @default(cuid())
  userId String
  title String
  body String
  channel NotificationChannel @default(IN_APP)
  readAt DateTime?
  metadata Json?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}

model Lead {
  id String @id @default(cuid())
  name String
  email String?
  phone String?
  company String?
  source String?
  status LeadStatus @default(NEW)
  notes String?
  ownerId String?
  clientId String?
  owner User? @relation("LeadOwner",fields:[ownerId],references:[id],onDelete:SetNull)
  client Client? @relation(fields:[clientId],references:[id],onDelete:SetNull)
  deals Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Deal {
  id String @id @default(cuid())
  title String
  value Float?
  stage String @default("NEW")
  status DealStatus @default(OPEN)
  expectedClose DateTime?
  leadId String?
  clientId String?
  ownerId String?
  lead Lead? @relation(fields:[leadId],references:[id],onDelete:SetNull)
  client Client? @relation(fields:[clientId],references:[id],onDelete:SetNull)
  owner User? @relation("DealOwner",fields:[ownerId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CRMActivity {
  id String @id @default(cuid())
  type String
  subject String
  body String?
  dueAt DateTime?
  completedAt DateTime?
  leadId String?
  dealId String?
  userId String?
  metadata Json?
  createdAt DateTime @default(now())
}

model AppRequest {
  id String @id @default(cuid())
  requestNumber String @unique @default(cuid())
  appName String
  idea String?
  description String?
  businessType String?
  targetAudience String?
  country String?
  language String?
  logoUrl String?
  colors Json?
  features Json?
  appTypes Json?
  status AppRequestStatus @default(NEW)
  progress Int @default(0)
  clientId String?
  serviceId String?
  projectId String?
  assigneeId String?
  client Client? @relation(fields:[clientId],references:[id],onDelete:SetNull)
  service Service? @relation(fields:[serviceId],references:[id],onDelete:SetNull)
  project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull)
  assignee User? @relation("AppRequestAssignee",fields:[assigneeId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id String @id @default(cuid())
  invoiceNumber String @unique @default(cuid())
  clientId String?
  projectId String?
  serviceId String?
  subtotal Float @default(0)
  discount Float @default(0)
  tax Float @default(0)
  total Float @default(0)
  paid Float @default(0)
  currency String @default("USD")
  paymentMethod String?
  issuedAt DateTime @default(now())
  dueAt DateTime?
  status InvoiceStatus @default(DRAFT)
  createdById String?
  client Client? @relation(fields:[clientId],references:[id],onDelete:SetNull)
  project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull)
  service Service? @relation(fields:[serviceId],references:[id],onDelete:SetNull)
  createdBy User? @relation("InvoiceCreator",fields:[createdById],references:[id],onDelete:SetNull)
}

model AuditLog {
  id String @id @default(cuid())
  action String
  entity String
  entityId String?
  metadata Json?
  userId String?
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
}
model Integration {
  id String @id @default(cuid())
  provider String @unique
  enabled Boolean @default(false)
  config Json?
  updatedAt DateTime @updatedAt
}
model BackupConfig {
  id String @id @default(cuid())
  enabled Boolean @default(false)
  schedule String @default("0 2 * * *")
  retentionDays Int @default(30)
  destination String?
  updatedAt DateTime @updatedAt
}
